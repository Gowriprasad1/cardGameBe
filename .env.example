# Copy these into your hosting provider's environment settings (never commit real values).

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
CLIENT_ORIGIN=https://your-app.vercel.app          # your frontend; several allowed, comma separated

# Recommended in production
NODE_ENV=production
AUTO_MIGRATE=true                                   # apply db/migrations at startup

# Optional (defaults shown)
LOG_LEVEL=info
TURN_TIMER_SECONDS=60                               # 0 = no turn timer
RECONNECT_GRACE_SECONDS=90
ROUND_BREAK_SECONDS=10
ROOM_IDLE_MINUTES=30
RATE_LIMIT_API=120
RATE_LIMIT_STRICT=20
SOCKET_BURST=20
SOCKET_RATE_PER_SECOND=8
